{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitsDisabled",
    "security:minimumReleaseAgeNpm"
  ],
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "corepack is installed explicitly: Node 25+ no longer bundles it",
      "managerFilePatterns": ["/(^|/)Dockerfile$/", "/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["corepack@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "corepack",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "rust crates"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "web packages"
    },
    {
      "description": "The package manager is a toolchain change; keep it out of the dependency group",
      "matchDepNames": ["pnpm", "corepack"],
      "groupName": "pnpm"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "matchManagers": ["dockerfile"],
      "groupName": "docker images"
    },
    {
      "description": "One Node version: the web stage image and .node-version (CI, release) move together",
      "matchDepNames": ["node"],
      "groupName": "node"
    },
    {
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["deploy/gateway-tools-requirements.txt"],
      "groupName": "gateway extractors"
    }
  ]
}
