    "/settings": {
      "get": {
        "operationId": "get_settings",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "patch_settings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsPatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/status": {
      "get": {
        "operationId": "status",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Channel": {
        "type": "object",
        "required": [
          "id",
          "name",
          "source",
          "source_key",
          "stream_url",
          "is_event",
          "enabled",
          "playlists",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "enabled": {
            "type": "boolean"
          },
          "group_title": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "is_event": {
            "type": "boolean"
          },
          "kickoff_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "name": {
            "type": "string"
          },
          "playlists": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Slugs of playlists containing this channel."
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "source_key": {
            "type": "string",
            "description": "Canonical key used for de-duplication (unique per source kind)."
          },
          "stream_url": {
            "type": "string",
            "description": "Stream URL as currently emitted in playlists."
          },
          "tvg_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "tvg_logo": {
            "type": [
              "string",
              "null"
            ]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ChannelCreate": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "group_title": {
            "type": [
              "string",
              "null"
            ]
          },
          "input": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_event": {
            "type": "boolean"
          },
          "kickoff_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "name": {
            "type": "string"
          },
          "playlists": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Playlists (by slug) to append the new channel to."
          },
          "source": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Source",
                "description": "Either a structured source, or free-form `input` (ace id, acestream:// link, vk.com URL, any URL)."
              },
              {
                "type": "null"
              }
            ]
          },
          "tvg_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "tvg_logo": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ChannelPatch": {
        "type": "object",
        "description": "Partial update. Absent fields are left unchanged; for nullable fields, `null` clears.",
        "properties": {
          "enabled": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "group_title": {
            "type": [
              "string",
              "null"
            ]
          },
          "input": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_event": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "kickoff_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Source"
              },
              {
                "type": "null"
              }
            ]
          },
          "tvg_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "tvg_logo": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable code: not_found, conflict, invalid, internal."
          },
          "message": {
            "type": "string"
          }
        }
      },
      "FieldDiff": {
        "type": "object",
        "required": [
          "field"
        ],
        "properties": {
          "existing": {
            "type": [
              "string",
              "null"
            ]
          },
          "field": {
            "type": "string"
          },
          "incoming": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ImportAction": {
        "type": "string",
        "enum": [
          "create",
          "reuse",
          "skip_in_playlist"
        ]
      },
      "ImportEntry": {
        "type": "object",
        "required": [
          "index",
          "name",
          "source",
          "source_key",
          "action",
          "diff"
        ],
        "properties": {
          "action": {
            "$ref": "#/components/schemas/ImportAction"
          },
          "channel_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "diff": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldDiff"
            },
            "description": "Fields where the file differs from the existing channel (existing metadata is never overwritten)."
          },
          "group_title": {
            "type": [
              "string",
              "null"
            ]
          },
          "index": {
            "type": "integer",
            "description": "1-based entry index in the file.",
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "source_key": {
            "type": "string"
          },
          "tvg_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "tvg_logo": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ImportReport": {
        "type": "object",
        "required": [
          "dry_run",
          "playlist_slug",
          "playlist_created",
          "entries",
          "skipped_lines"
        ],
        "properties": {
          "dry_run": {
            "type": "boolean"
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImportEntry"
            }
          },
          "playlist_created": {
            "type": "boolean"
          },
          "playlist_slug": {
            "type": "string"
          },
          "skipped_lines": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Lines that could not be parsed into an entry."
          }
        }
      },
      "ImportRequest": {
        "type": "object",
        "required": [
          "playlist_slug"
        ],
        "properties": {
          "dry_run": {
            "type": "boolean"
          },
          "m3u_text": {
            "type": [
              "string",
              "null"
            ],
            "description": "Raw m3u text (exactly one of `m3u_text` / `url`)."
          },
          "playlist_slug": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ItemAdd": {
        "type": "object",
        "required": [
          "channel_id"
        ],
        "properties": {
          "channel_id": {
            "type": "integer",
            "format": "int64"
          },
          "position": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "1-based insert position; appended when absent or beyond the end."
          }
        }
      },
      "ItemsReplace": {
        "type": "object",
        "required": [
          "channel_ids"
        ],
        "properties": {
          "channel_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Full new order of channel ids."
          }
        }
      },
      "MoveRequest": {
        "type": "object",
        "required": [
          "position"
        ],
        "properties": {
          "position": {
            "type": "integer",
            "format": "int64",
            "description": "New 1-based position (clamped)."
          }
        }
      },
      "Playlist": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "channel_count",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "channel_count": {
            "type": "integer",
            "format": "int64"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PlaylistCreate": {
        "type": "object",
        "required": [
          "slug"
        ],
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "slug": {
            "type": "string"
          }
        }
      },
      "PlaylistDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Playlist"
          },
          {
            "type": "object",
            "required": [
              "items"
            ],
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/PlaylistItem"
                }
              }
            }
          }
        ]
      },
      "PlaylistItem": {
        "type": "object",
        "required": [
          "position",
          "channel"
        ],
        "properties": {
          "channel": {
            "$ref": "#/components/schemas/Channel"
          },
          "position": {
            "type": "integer",
            "format": "int64",
            "description": "1-based position; emitted as tvg-chno."
          }
        }
      },
      "PlaylistPatch": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "slug": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "slugs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Playlists to refresh; all when absent or empty."
          }
        }
      },
      "RefreshResponse": {
        "type": "object",
        "required": [
          "slugs"
        ],
        "properties": {
          "slugs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ResolveRequest": {
        "type": "object",
        "required": [
          "input"
        ],
        "properties": {
          "input": {
            "type": "string"
          }
        }
      },
      "ResolveResponse": {
        "type": "object",
        "required": [
          "source",
          "source_key",
          "stream_url"
        ],
        "properties": {
          "duplicate_of": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Existing channel with the same source, if any."
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "source_key": {
            "type": "string"
          },
          "stream_url": {
            "type": "string"
          }
        }
      },
      "Settings": {
        "type": "object",
        "required": [
          "acexy_base",
          "engine_base",
          "vk_base"
        ],
        "properties": {
          "acexy_base": {
            "type": "string"
          },
          "engine_base": {
            "type": "string"
          },
          "vk_base": {
            "type": "string"
          }
        }
      },
      "SettingsPatch": {
        "type": "object",
        "properties": {
          "acexy_base": {
            "type": [
              "string",
              "null"
            ]
          },
          "engine_base": {
            "type": [
              "string",
              "null"
            ]
          },
          "vk_base": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Source": {
        "oneOf": [
          {
            "type": "object",
            "description": "Acestream content id (40 lowercase hex chars), played through acexy.",
            "required": [
              "id",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "acestream"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "VK video, played through the VK proxy.",
            "required": [
              "owner_id",
              "video_id",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "vk"
                ]
              },
              "list": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "owner_id": {
                "type": "integer",
                "format": "int64"
              },
              "video_id": {
                "type": "integer",
                "format": "int64"
              }
            }
          },
          {
            "type": "object",
            "description": "Any other URL, emitted verbatim.",
            "required": [
              "url",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "raw"
                ]
              },
              "url": {
                "type": "string"
              }
            }
          }
        ],
        "description": "A channel's stream source. The full URL is built from the per-kind base URL in settings."
      },
      "SourceKind": {
        "type": "string",
        "enum": [
          "acestream",
          "vk",
          "raw"
        ]
      },
      "Status": {
        "type": "object",
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "type": "string"
          }
        }
      }
    }
  }
}
