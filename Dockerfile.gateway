# lineup-gateway: the Rust binary plus pinned extractors (yt-dlp, streamlink) in a venv.
# Build: docker build -f Dockerfile.gateway -t lineup-gateway .

# ---- gateway ---------------------------------------------------------------
FROM rust:1.100-alpine AS rust
RUN apk add --no-cache musl-dev build-base
WORKDIR /src
COPY Cargo.toml Cargo.lock rustfmt.toml ./
COPY crates ./crates
RUN cargo build --release --locked -p lineup-gateway && cp target/release/lineup-gateway /lineup-gateway && rm -rf target

# ---- extractors ------------------------------------------------------------
FROM python:3.15-alpine AS tools
# Every package pinned (deploy/gateway-tools-requirements.txt), installed without resolving new
# ones, then checked: consistent dependencies, and streamlink can prepare a request (its urllib3
# patches fail there, offline, when urllib3 moves under it).
COPY deploy/gateway-tools-requirements.txt /tmp/requirements.txt
RUN python -m venv /opt/tools \
    && /opt/tools/bin/pip install --no-cache-dir --no-deps -r /tmp/requirements.txt \
    && /opt/tools/bin/pip check \
    && /opt/tools/bin/python -c "import requests, streamlink; streamlink.Streamlink().http.prepare_request(requests.Request('GET', 'https://example.com/a b'))" \
    && /opt/tools/bin/yt-dlp --version && /opt/tools/bin/streamlink --version

# ---- runtime ---------------------------------------------------------------
FROM python:3.15-alpine
RUN apk add --no-cache ca-certificates tzdata \
    && adduser -D -H -u 10002 gateway
COPY --from=tools /opt/tools /opt/tools
COPY --from=rust /lineup-gateway /usr/local/bin/lineup-gateway
COPY deploy/gateway.example.toml /etc/lineup-gateway.toml
USER gateway
ENV LINEUP_GATEWAY_CONFIG=/etc/lineup-gateway.toml
EXPOSE 8099
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s \
    CMD ["lineup-gateway", "--healthcheck"]
ENTRYPOINT ["lineup-gateway"]
